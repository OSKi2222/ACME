{
  "name": "group-acme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n TAILWIND,VITE -c yellow,cyan \"npm:watch:css\" \"vite\"",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css --watch",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/style.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "alpinejs": "^3.14.3",
    "gsap": "^3.12.5",
    "lenis": "^1.3.25",
    "swup": "^4.8.1"
  }
}
